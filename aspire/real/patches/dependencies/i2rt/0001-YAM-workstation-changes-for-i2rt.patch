+    def _read_register_uint32(self, motor_id: int, reg_id: int, expected_id: int = _SPECIAL_MSG_ID) -> int:
+        data = [motor_id, 0x00, self._REG_READ_CMD, reg_id, 0x00, 0x00, 0x00, 0x00]
+        try:
+            message = self._send_message_get_response(
+                self._SPECIAL_MSG_ID, motor_id, data, max_retry=20, expected_id=expected_id
+            )
+        except AssertionError as e:
+            raise TimeoutError(f"Failed to read register {reg_id} from motor {motor_id}") from e
+        return struct.unpack("<I", message.data[4:8])[0]
+
+    def _write_register_uint32(self, motor_id: int, reg_id: int, value: int, expected_id: int = _SPECIAL_MSG_ID) -> int:
+        payload = struct.pack("<I", int(value))
+        data = [motor_id, 0x00, self._REG_WRITE_CMD, reg_id] + list(payload)
+        try:
+            message = self._send_message_get_response(
+                self._SPECIAL_MSG_ID, motor_id, data, max_retry=20, expected_id=expected_id
+            )
+        except AssertionError as e:
+            raise TimeoutError(f"Failed to write register {reg_id} for motor {motor_id}") from e
+        return struct.unpack("<I", message.data[4:8])[0]
+
+    def ensure_control_mode(self, motor_id: int, control_mode: str, motor_type: Optional[str] = None) -> None:
+        """
+        Ensure control mode (register 10) matches the desired mode.
+        Reads register 10; if it differs, writes and verifies.
+
+        Args:
+            motor_id (int): The ID of the motor.
+            control_mode (str): "MIT", "POS_VEL", "VEL", or "FORCE_POS"
+
+        Raises:
+            ValueError: If control_mode is invalid or register value is invalid.
+            TimeoutError: If reading/writing register times out.
+            RuntimeError: Other errors during register operations, or if verification after write fails.
+        """
+        mode_to_register = {
+            ControlMode.MIT: 1,
+            ControlMode.POS_VEL: 2,
+            ControlMode.VEL: 3,
+            ControlMode.FORCE_POS: 4,
+        }
+        if control_mode not in mode_to_register:
+            raise ValueError(
+                f"Invalid control_mode: {control_mode}. Must be one of {list(mode_to_register.keys())}"
+            )
+        desired = mode_to_register[control_mode]
+
+        current = int(self._read_register_uint32(motor_id, 10, self.receive_mode.get_receive_id(motor_id)))
+        if current == desired:
+            print(f"✓ Control mode already set to {control_mode}")
+            return
+        print(f"⚠ Control mode mismatch: register 10 = {current}, required = {desired}")
+        print(f"  Setting control mode to {control_mode} (register value: {desired})...")
+        self._write_register_uint32(motor_id, 10, desired, self.receive_mode.get_receive_id(motor_id))
+        time.sleep(0.1)
+        verify = int(self._read_register_uint32(motor_id, 10, self.receive_mode.get_receive_id(motor_id)))
+        if verify != desired:
+            raise RuntimeError(
+                f"Control mode verification failed after write: expected {desired}, got {verify}"
+            )
+        print(f"✓ Control mode set to {control_mode}")
+        if motor_type is not None:
+            self.motor_on(motor_id, motor_type)
+
     def _get_frame_id(self, motor_id: int) -> int:
         """Calculate the Control Frame ID for a given motor."""
         return self.cmd_idoffset + motor_id
 
+    def _get_frame_id_with_mode(self, motor_id: int, control_mode: Optional[str]) -> int:
+        if control_mode is None:
+            return self._get_frame_id(motor_id)
+        return ControlMode.get_id_offset(control_mode) + motor_id
+
     def motor_on(self, motor_id: int, motor_type: str) -> None:
         """Turn on the motor.
 
